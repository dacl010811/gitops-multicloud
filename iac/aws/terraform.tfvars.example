# ============================================
# Plantilla de variables para iac/aws
# ============================================
# IMPORTANTE: terraform.tfvars está en .gitignore (*.tfvars), por lo que NO se
# versiona ni se sincroniza a la EC2 vía git. En la máquina donde ejecutes
# Terraform debes crear el archivo real:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# ============================================
# Escenario A: Cuenta AWS real (recomendado)
# ============================================
# El IAM User 'terraform-ci' tiene permisos iam:CreateRole, por lo que
# Terraform crea los roles del control plane y de los nodos automáticamente.
# Dejar vacíos para que el módulo los provisione.

cluster_role_arn = ""
node_role_arn    = ""

# ============================================
# Escenario B: AWS Academy / Learner Lab
# ============================================
# El rol voclabs NO permite iam:CreateRole. LabRole es el único rol utilizable
# y sirve tanto para el control plane de EKS como para los nodos workers.
# Descomentar y ajustar el Account ID si usas Academy:
#
# cluster_role_arn = "arn:aws:iam::<ACCOUNT_ID>:role/LabRole"
# node_role_arn    = "arn:aws:iam::<ACCOUNT_ID>:role/LabRole"

# Otras variables (opcionales; tienen defaults en variables.tf):
# region             = "us-east-1"
# cluster_name       = "sri-eks-cluster"
# kubernetes_version = "1.30"
# environment        = "production"
# node_count         = 3
# node_instance_type = "t3.medium"
