{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SSMReadSriFacturacion",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:053044806920:parameter/sri-facturacion/*"
      ]
    },
    {
      "Sid": "KMSDecryptSSMDefaultKey",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "kms:RequestAlias": "alias/aws/ssm"
        }
      }
    }
  ]
}
